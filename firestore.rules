rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function adminEmails() {
      return [
        'tjayburger2004@gmail.com',
        // IMPORTANT: Add your email here after checking the browser console
        // When you try to upload, check console.log('👤 Current user email:', ...)
        // Then add your email to this list and deploy the rules
      ];
    }

    function isAdmin() {
      // Check if user is signed in and has email
      return isSignedIn() 
        && request.auth.token.email != null
        && (
          // Check if email matches admin email
          request.auth.token.email.toLowerCase() == 'tjayburger2004@gmail.com'
          ||
          // OR check if user has admin tier (check their user document)
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier == 'admin'
          )
        );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnerField(field) {
      return isSignedIn() && field != null && field == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && (
          !('tier' in request.resource.data)
          || request.resource.data.tier in ['free', 'starter']
        );
      allow update: if isOwner(userId)
        && resource != null
        && (
          !('tier' in request.resource.data)
          || request.resource.data.tier == resource.data.tier
          || (
            request.resource.data.tier in ['free', 'starter', 'pro', 'business', 'premium']
            && request.resource.data.payfastToken is string
            && request.resource.data.payfastToken != ''
          )
        );
      allow delete: if false;
    }

    match /merchantSettings/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /services/{serviceId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    match /user_websites/{websiteId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    match /userWebsites/{websiteId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource != null && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}